{
  "name": "bi-report-kit",
  "version": "0.1.1",
  "description": "Embeddable BI reporting toolkit for React/Next.js — query layer, semantic layer, dashboard builder, charts, export, permissions and scheduling.",
  "type": "module",
  "main": "./dist/bi-report-kit.cjs",
  "module": "./dist/bi-report-kit.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bi-report-kit.js",
      "require": "./dist/bi-report-kit.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.build.json && vite build && vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "alasql": "^4.19.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.446.0",
    "pg": "^8.23.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.1.0"
  },
  "keywords": [
    "react",
    "bi",
    "business-intelligence",
    "dashboard",
    "reporting",
    "charts",
    "analytics"
  ],
  "license": "MIT"
}
